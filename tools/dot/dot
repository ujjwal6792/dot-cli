#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
TOOL_DIR="${DOT_ENGINE:-$(cd -L "$(dirname "$SOURCE")" && pwd)}"
find_compatible_python() {
  for candidate in python3 python3.16 python3.15 python3.14 python3.13 python3.12 python3.11; do
    candidate_path="$(command -v "$candidate" 2>/dev/null || true)"
    case "$candidate_path" in /*) ;; *) continue ;; esac
    if "$candidate_path" -c 'import sys,tomllib; sys.exit(sys.version_info < (3,11))' >/dev/null 2>&1; then
      printf '%s\n' "$candidate_path"
      return 0
    fi
  done
  return 1
}
resolve_state_dir() {
  local python_bin="${1:-}"
  [ -n "$python_bin" ] || python_bin="$(find_compatible_python || true)"
  [ -n "$python_bin" ] || { echo 'dot: Python 3.11+ is required to safely resolve runtime state' >&2; return 1; }
  "$python_bin" -B "$TOOL_DIR/state_paths.py" resolve
}
case "${1:-}" in
  --help|-h|help)
    cat <<'EOF'
dot — independent configuration CLI
usage: dot (opens the interactive TUI app: Welcome to Done menu)
       dot init [--check] [--source ABS] [--config ABS] [--rounds] [--url URL] [--name NAME] [--email EMAIL]
       dot --version | dot -v | dot --help | dot -h
       dot -u | dot --uninstall | dot --health
       dot status | diff [--direction repo-to-machine|machine-to-repo] | push --message TEXT
       dot pull [--yes] | self-update [--yes] | browse
       dot add --class shared|templated|os-only [--os darwin|linux] PATH | remove PATH
       dot update NAME VERSION | run NAME [ARGS...] | doctor
       dot scope init|show|catalog|expand GROUP... [--yes] [--ack-unsafe] [--ack-desktop]
       dot intent rounds|pick [--mode track|adopt]|inventory PATH|plan REQUEST --out PLAN|preview PLAN|apply PLAN --approve ID [--ack-unsafe] [--ack-desktop] [--replace-skills-backup]
       dot layout plan --out PLAN|apply PLAN --approve ID
       dot contract check | migrate

Help, version, uninstall, and health are independent of Python and private
configuration. `dot init --check` performs read-only prerequisite,
connection, and tracker detection and reports an old-user/new-user verdict.
With no arguments, `dot` opens the interactive TUI app (Welcome to Done
menu); only plumbing stays outside the app.
EOF
    exit 0 ;;
  --version|version|-v)
    VERSION_FILE="$(dirname "$(dirname "$TOOL_DIR")")/release.json"
    if [ -r "$VERSION_FILE" ]; then
      sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/dot \1/p' "$VERSION_FILE"
    else
      echo 'dot development build'
    fi
    exit 0 ;;
  -u|--uninstall)
    cat <<'EOF'
dot uninstall (read-only guidance; nothing was removed):
  1. Remove the launcher: ~/.local/bin/dot
  2. Remove the public engine: ~/.local/share/dot-cli
  3. Optionally remove private state after review: ~/.local/state/dot
Private checkouts and live files are never touched by this command.
EOF
    exit 0 ;;
  --health)
    echo "Public engine: $TOOL_DIR"
    for requirement in bash git curl python3 chezmoi; do
      if command -v "$requirement" >/dev/null 2>&1; then
        printf 'Requirement %s: available\n' "$requirement"
      else
        printf 'Requirement %s: missing (review/install through dot init only)\n' "$requirement"
      fi
    done
    BROWSER="${DOT_BROWSER:-$TOOL_DIR/../../bin/dot-browser}"
    if [ -x "$BROWSER" ]; then
      echo 'Browser: available'
    else
      echo 'Browser: missing (install a compatible dot-browser artifact)'
    fi
    exit 0 ;;
  '')
    : "${HOME:?dot: HOME must be set}"
    BROWSER="${DOT_BROWSER:-$TOOL_DIR/../../bin/dot-browser}"
    [ -x "$BROWSER" ] || { echo 'dot: browser unavailable; install a compatible dot-browser artifact' >&2; exit 1; }
    # shellcheck disable=SC2269 # DOT_SOURCE default is intentional for new users.
    exec "$BROWSER" --engine "$TOOL_DIR" --home "$HOME" --source "${DOT_SOURCE:-$HOME/.local/share/dot-config}" --init ;;
esac
if [ "${DOT_STATE_DIR+x}" = x ]; then
  case "$DOT_STATE_DIR" in /*) ;; *) echo 'dot: DOT_STATE_DIR must be absolute' >&2; exit 2 ;; esac
  case "$DOT_STATE_DIR" in *'/../'*|*/..|*'/./'*|*/.|*'//'|*[![:print:]]*) echo 'dot: DOT_STATE_DIR must be normalized and contain no control characters' >&2; exit 2 ;; esac
  current=
  IFS=/ read -r -a state_parts <<< "$DOT_STATE_DIR"
  for part in "${state_parts[@]}"; do
    [ -n "$part" ] || continue
    current="$current/$part"
    [ ! -L "$current" ] || { echo "dot: DOT_STATE_DIR traverses a symlink: $current" >&2; exit 2; }
  done
fi
if [ "${1:-}" = init ]; then
  shift
  if [ "${1:-}" = --check ]; then
    check_source="${DOT_SOURCE:-}"
    check_config="${DOT_CONFIG:-}"
    previous=''
    for argument in "$@"; do
      case "$previous:$argument" in
        --source:*) check_source="$argument" ;;
        --config:*) check_config="$argument" ;;
      esac
      previous="$argument"
    done
    PYTHON_BIN="$(find_compatible_python || true)"
    state_dir=''
    if [ -n "$PYTHON_BIN" ]; then state_dir="$(resolve_state_dir "$PYTHON_BIN")" || exit 2; fi
    connection_record="${state_dir:+$state_dir/connection.json}"
    if [ -n "$PYTHON_BIN" ] && { { [ -n "$check_source" ] && [ -n "$check_config" ]; } || [ -f "$connection_record" ]; }; then
      DOT_ENGINE="${DOT_ENGINE:-$TOOL_DIR}" DOT_PYTHON="$PYTHON_BIN" exec "$PYTHON_BIN" -B "$TOOL_DIR/init.py" --check "$@"
    fi
    echo "Public engine: $TOOL_DIR"
    if [ -n "$PYTHON_BIN" ]; then
      echo "Python 3.11+: available ($PYTHON_BIN)"
    elif command -v python3 >/dev/null 2>&1; then
      python_version="$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:3])))' 2>/dev/null || true)"
      echo "Python 3.11+: unavailable or too old${python_version:+ (detected $python_version)}"
    else
      echo 'Python 3.11+: missing; install it using your platform package manager, then rerun dot init. No dependency was installed.'
    fi
    for requirement in bash git curl python3 chezmoi; do
      if command -v "$requirement" >/dev/null 2>&1; then
        printf 'Requirement %s: available\n' "$requirement"
      else
        printf 'Requirement %s: missing (review/install through dot init only)\n' "$requirement"
      fi
    done
    if [ -n "${DOT_SOURCE:-}" ] && [ -d "$DOT_SOURCE" ]; then
      echo "Private checkout: $DOT_SOURCE"
    else
      echo 'Private checkout: not configured; dot init can offer retrieval only after explicit consent.'
    fi
    if [ -n "${DOT_CONFIG:-}" ] && [ -f "$DOT_CONFIG" ]; then
      echo "Tracker config: $DOT_CONFIG (requires identity/compatibility validation)"
    else
      echo 'Tracker: not configured; dot init can offer creation only after separate explicit consent.'
    fi
    if [ -n "$state_dir" ]; then
      record="$state_dir/install.json"
      if [ -f "$record" ]; then echo "Install record: $record"; else echo 'Install record: not present'; fi
      if [ -f "$connection_record" ]; then echo "Private connection record: $connection_record (read-only; validation needs Python 3.11+)"; else echo 'Private connection: not recorded'; fi
    else
      echo 'Runtime state: not inspected (Python 3.11+ required for safe path validation).'
    fi
    exit 0
  fi
  PYTHON_BIN="$(find_compatible_python || true)"
  if [ -z "$PYTHON_BIN" ]; then
    exec bash "$TOOL_DIR/init-python-bootstrap.sh" "$TOOL_DIR" "$@"
  fi
  export DOT_ENGINE="${DOT_ENGINE:-$TOOL_DIR}" DOT_PYTHON="$PYTHON_BIN"
  exec "$PYTHON_BIN" -B "$TOOL_DIR/init.py" "$@"
fi
if [ "${1:-}" = self-update ]; then
  state_dir="$(resolve_state_dir)" || exit 1
  INSTALL_RECORD="$state_dir/install.json"
  [ ! -L "$INSTALL_RECORD" ] || { echo 'dot self-update: installation record symlink is refused' >&2; exit 1; }
  if [ -f "$INSTALL_RECORD" ] && grep -q '"kind"[[:space:]]*:[[:space:]]*"package-manager"' "$INSTALL_RECORD"; then
    if grep -q '"manager"[[:space:]]*:[[:space:]]*"brew"' "$INSTALL_RECORD"; then echo 'dot self-update: package-manager-owned; run brew upgrade dots-cli' >&2; exit 1; fi
    if grep -q '"manager"[[:space:]]*:[[:space:]]*"pacman"' "$INSTALL_RECORD"; then echo 'dot self-update: package-manager-owned; run pacman -Syu' >&2; exit 1; fi
    echo 'dot self-update: unknown package-manager owner; refusing to write' >&2; exit 1
  fi
  if [ -f "$INSTALL_RECORD" ] && grep -q '"kind"[[:space:]]*:[[:space:]]*"artifact"' "$INSTALL_RECORD"; then
    INSTALL_ROOT="$(sed -n 's/.*"engine_path":"\(.*\)\/current\/tools\/dot".*/\1/p' "$INSTALL_RECORD")"
    [ -n "$INSTALL_ROOT" ] || { echo 'dot self-update: invalid artifact install record; refusing to write' >&2; exit 1; }
    shift
    state_args=()
    [ -z "${DOT_STATE_DIR:-}" ] || state_args=(--state-dir "$DOT_STATE_DIR")
    exec sh "$TOOL_DIR/../../install.sh" --self-update "$@" --root "$INSTALL_ROOT" "${state_args[@]}"
  fi
fi
if [ -z "${DOT_ENGINE:-}" ] && [ ! -f "$TOOL_DIR/../../dot-contract.json" ] && [ "${1:-}" != contract ] && [ "${1:-}" != self-update ] && [ "${1:-}" != migrate ]; then
  echo 'dot: public engine requires explicit DOT_ENGINE and private DOT_SOURCE; use the installed dot launcher' >&2
  exit 1
fi
if [ -n "${DOT_ENGINE:-}" ] && [ "${1:-}" != contract ] && [ "${1:-}" != self-update ] && [ "${1:-}" != migrate ] && [ -z "${DOT_SOURCE:-}" ]; then
  state_dir="$(resolve_state_dir)" || exit 1
  if [ ! -f "$state_dir/connection.json" ]; then
  echo 'dot: explicit DOT_SOURCE is required with DOT_ENGINE; run dot init to establish a private connection' >&2
  exit 1
  fi
fi
PYTHON_BIN="$(find_compatible_python || true)"
if [ "${1:-}" != self-update ] && [ -z "$PYTHON_BIN" ]; then
  echo 'dot: engine commands require Python 3.11+ with tomllib; run dot init --check, then install Python through dot init.' >&2
  exit 1
fi
if [ "${1:-}" != contract ] && [ "${1:-}" != self-update ] && [ "${1:-}" != migrate ]; then
  DOT_ENGINE="${DOT_ENGINE:-$TOOL_DIR}"
  export DOT_ENGINE
  if [ -n "$PYTHON_BIN" ]; then
    export DOT_PYTHON="$PYTHON_BIN"
  fi
  if [ -n "${DOT_STATE_DIR:-}" ]; then
    state_dir="$DOT_STATE_DIR"
  elif [ -n "${XDG_STATE_HOME:-}" ]; then
    state_dir="$XDG_STATE_HOME/dot"
  else
    state_dir="${HOME:?HOME must be set}/.local/state/dot"
  fi
  if [ -n "$PYTHON_BIN" ]; then
    if [ -n "${DOT_STATE_DIR:-}" ]; then
      state_dir="$DOT_STATE_DIR"
    elif [ -n "${XDG_STATE_HOME:-}" ]; then
      state_dir="$XDG_STATE_HOME/dot"
    else
      state_dir="$("$PYTHON_BIN" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve() / ".local/state/dot")' "$HOME")"
    fi
  fi
  connection_record="$state_dir/connection.json"
  if [ -f "$connection_record" ]; then
    requested_source="${DOT_SOURCE:-}"
    requested_config="${DOT_CONFIG:-}"
    [ -n "$PYTHON_BIN" ] || { echo 'dot: private connection record requires Python 3.11+ validation; run dot init --check and install Python through dot init.' >&2; exit 1; }
    exports="$("$PYTHON_BIN" - "$TOOL_DIR" "$state_dir" <<'PY'
import shlex,sys
sys.path.insert(0,sys.argv[1])
import install_state
record=install_state.read_connection(sys.argv[2])
if record is None:
    raise SystemExit(3)
print('DOT_SOURCE=' + shlex.quote(record['private_source']))
print('DOT_CONFIG=' + shlex.quote(record['config_path']))
PY
    )" || { echo 'dot: invalid or unreadable private connection record; run dot init --check; no fallback source selected.' >&2; exit 1; }
    eval "$exports"
    if { [ -n "$requested_source" ] && [ "$requested_source" != "$DOT_SOURCE" ]; } || { [ -n "$requested_config" ] && [ "$requested_config" != "$DOT_CONFIG" ]; }; then
      echo 'dot: explicit private source conflicts with the saved connection; run dot init to review a connection update.' >&2
      exit 1
    fi
    export DOT_SOURCE DOT_CONFIG
  elif [ -z "${DOT_SOURCE:-}" ] || [ -z "${DOT_CONFIG:-}" ]; then
    echo 'dot: private connection not initialized; run dot init. No public-checkout source fallback is used.' >&2
    exit 1
  fi
fi
# Migration validates the recorded legacy references itself: the normal split
# tracker gate cannot be satisfied until those references are explicitly migrated.
if [ "${1:-}" = migrate ]; then
  shift
  : "${DOT_SOURCE:?dot migrate requires the explicit recorded installed DOT_SOURCE}"
  exec "$PYTHON_BIN" -B "$TOOL_DIR/migration.py" "$@"
fi
IS_CONTRACT=false
[ "${1:-}" = contract ] && IS_CONTRACT=true
if [ -z "${DOT_ENGINE:-}" ] && [ ! -f "$TOOL_DIR/../../dot-contract.json" ] && [ "$IS_CONTRACT" != true ]; then
  echo 'dot: public engine requires explicit DOT_ENGINE and private DOT_SOURCE; use the installed dot launcher' >&2
  exit 1
fi
if [ -n "${DOT_ENGINE:-}" ]; then
  [ -f "$TOOL_DIR/engine.json" ] && [ -f "$TOOL_DIR/contract.py" ] || { echo 'dot: explicit DOT_ENGINE is incomplete; refusing private-source fallback' >&2; exit 1; }
  if [ "${1:-}" != contract ]; then
    [ -n "${DOT_SOURCE:-}" ] || { echo 'dot: explicit DOT_SOURCE is required with DOT_ENGINE' >&2; exit 1; }
    if [ "${1:-}" != self-update ] && { [ -z "${DOT_CONFIG:-}" ] || [ ! -f "$DOT_CONFIG" ]; }; then
      echo 'dot: chezmoi tracker is not initialized; run dot init to review dependencies and tracker creation' >&2
      exit 1
    fi
    if [ "${1:-}" != self-update ] && [ -n "${DOT_CONFIG:-}" ]; then
      configured_engine="$("$PYTHON_BIN" - "$DOT_CONFIG" <<'PY'
import sys,tomllib
with open(sys.argv[1],'rb') as f: print(tomllib.load(f).get('data',{}).get('dotEngine',''))
PY
      )"
      [ "$configured_engine" = "$TOOL_DIR" ] || { echo 'dot: chezmoi [data] dotEngine does not match explicit DOT_ENGINE' >&2; exit 1; }
    fi
    "$PYTHON_BIN" -B "$TOOL_DIR/contract.py" check --engine "$TOOL_DIR" --source "$DOT_SOURCE" >/dev/null || exit $?
  fi
fi
if [ "${1:-}" = contract ]; then
  shift
  exec "$PYTHON_BIN" -B "$TOOL_DIR/contract.py" "$@"
fi
if [ -z "${DOT_SOURCE:-}" ] && [ ! -f "$TOOL_DIR/../../dot-contract.json" ]; then
  echo 'dot: public engine requires explicit private DOT_SOURCE; refusing public-checkout or chezmoi source fallback' >&2
  exit 1
fi
if [ "${1:-}" = browse ]; then
  shift
  : "${DOT_SOURCE:?dot browse requires an explicit private DOT_SOURCE}"
  BROWSER="${DOT_BROWSER:-$TOOL_DIR/../../bin/dot-browser}"
  [ -x "$BROWSER" ] || { echo 'dot: browser unavailable; install a compatible dot-browser artifact' >&2; exit 1; }
  exec "$BROWSER" --engine "${DOT_ENGINE:-$TOOL_DIR}" --source "$DOT_SOURCE" --home "$HOME" "$@"
fi
DOT_SOURCE="${DOT_SOURCE:-$(cd "$TOOL_DIR/../.." && pwd)}"
CM_SOURCE="$DOT_SOURCE/home"
# Transitional legacy targets retain their existing boundary until migrated.
[ -d "$CM_SOURCE" ] || CM_SOURCE="$DOT_SOURCE"
cm() {
  if [ -n "${DOT_CONFIG:-}" ]; then
    chezmoi --no-tty --no-pager --use-builtin-diff --source "$CM_SOURCE" --destination "$HOME" --config "$DOT_CONFIG" "$@"
  else
    chezmoi --no-tty --no-pager --use-builtin-diff --source "$CM_SOURCE" --destination "$HOME" "$@"
  fi
}
g() { git -C "$DOT_SOURCE" "$@"; }
fail() { echo "dot: $*" >&2; return 1; }
usage() { echo 'usage: dot status | diff [--direction repo-to-machine|machine-to-repo] | push --message TEXT | self-update [--yes] | pull [--yes] | intent rounds|pick [--mode track|adopt]|inventory PATH|plan REQUEST --out PLAN|preview PLAN|apply PLAN --approve ID [--ack-unsafe] [--ack-desktop] [--replace-skills-backup]|update [--yes] | layout plan --out PLAN|apply PLAN --approve ID | add --class shared|templated|os-only [--os darwin|linux] PATH | remove PATH | update NAME VERSION | run NAME [ARGS...] | doctor | scope init|show|catalog|expand GROUP... [--yes] [--ack-unsafe] [--ack-desktop]' >&2; return 2; }
dot_status() {
  [ $# -eq 0 ] || { usage; return; }
  local state failed=0
  state="$(cm status)" || failed=$?
  printf '%s\n' "$state"
  g status --short --branch
  if [ "$failed" -ne 0 ]; then
    echo 'drift: unavailable — chezmoi could not render the source tree' >&2
    printf 'Inspect actual tracker: chezmoi --source "%s" --destination "%s"' "$CM_SOURCE" "$HOME" >&2
    [ -z "${DOT_CONFIG:-}" ] || printf ' --config "%s"' "$DOT_CONFIG" >&2
    printf ' doctor\nRun dot init --check for read-only identity diagnostics; review required machine data in the actual config; do not delete machine data or apply unscoped configuration.\n' >&2
    return "$failed"
  fi
  printf 'drift: %s managed entries differ; choose push (machine → repo) or pull (repo → machine)\n' "$(printf '%s\n' "$state" | awk 'NF {n++} END {print n+0}')"
  "$PYTHON_BIN" -B - "$TOOL_DIR" "$HOME" <<'PY'
import sys
sys.path.insert(0,sys.argv[1])
import scope
approval=scope.load(sys.argv[2])
if approval is None:
    print('scope: no adoption approval; managed drift is not whole-machine parity')
elif approval['version'] in (2,3):
    count=len(approval['entries'])
    print(f'scope: {count} selected entries; exact approval only')
    if not count:
        print('empty adoption scope: zero drift is not whole-machine parity')
else:
    print('scope: legacy group approval; review exact scope before independent pull')
PY
}
dot_diff() {
  local direction=repo-to-machine
  if [ $# -gt 0 ]; then
    [ $# -eq 2 ] && [ "$1" = --direction ] || { usage; return; }
    direction="$2"
  fi
  case "$direction" in
    repo-to-machine) echo 'repo → machine'; cm diff ;;
    machine-to-repo) echo 'machine → repo (you are ahead if these are intentional local changes)'; cm diff --reverse ;;
    *) usage ;;
  esac
}
dot_push() {
  [ $# -eq 2 ] && [ "$1" = --message ] && [ -n "$2" ] || { usage; return; }
  [ -z "$(g diff --cached --name-only)" ] || { fail 'staged changes exist; commit them separately'; return; }
  local paths path source state
  local sources=()
  paths="$(cm managed --include files --path-style absolute)"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    source="$(cm source-path "$path")"
    [ -n "$source" ] || continue
    [ -z "$(g status --porcelain -- "$source")" ] || { fail "source changes exist: $source"; return; }
  done <<< "$paths"
  state="$(cm status --include files --path-style absolute)"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    path="${path:3}"
    source="$(cm source-path "$path")"
    case "$source" in *.tmpl) fail "edit template explicitly before push: $source"; return ;; esac
    [ -f "$path" ] || { fail "missing managed file: $path"; return; }
    sources+=("$source")
  done <<< "$state"
  if [ "${#sources[@]}" -gt 0 ]; then
    cm re-add
    g add -- "${sources[@]}"
    if ! g diff --cached --quiet; then g commit -m "$2"; fi
  fi
  g push
}
dot_pull() {
  DOT_ENGINE="$TOOL_DIR" DOT_SOURCE="$DOT_SOURCE" "$PYTHON_BIN" -B "$TOOL_DIR/updates.py" pull "$@"
}
dot_self_update() { DOT_ENGINE="$TOOL_DIR" DOT_SOURCE="$DOT_SOURCE" "$PYTHON_BIN" -B "$TOOL_DIR/updates.py" self-update "$@"; }
metadata() { "$PYTHON_BIN" -B "$TOOL_DIR/state.py" "$@"; }
scope() { "$PYTHON_BIN" -B "$TOOL_DIR/scope.py" "$1" "$DOT_SOURCE" "$HOME" "${@:2}"; }
dot_scope() { scope "${1:-show}" "${@:2}"; }
dot_intent() { DOT_SOURCE="$DOT_SOURCE" "$PYTHON_BIN" -B "$TOOL_DIR/intent.py" "$@"; }
dot_layout() { DOT_SOURCE="$DOT_SOURCE" "$PYTHON_BIN" -B "$TOOL_DIR/layout.py" "$@"; }
dot_add() {
  [ ! -f "$DOT_SOURCE/dot-contract.json" ] || { fail 'tracking requires an exact dot intent Track plan/approval'; return; }
  local category os_name=- relative path
  [ $# -ge 3 ] && [ "$1" = --class ] || { usage; return; }
  category="$2"; shift 2
  case "$category" in
    shared|templated) ;;
    os-only)
      [ $# -eq 3 ] && [ "$1" = --os ] || { usage; return; }
      os_name="$2"; shift 2
      case "$os_name" in darwin|linux) ;; *) usage; return ;; esac ;;
    *) usage; return ;;
  esac
  [ $# -eq 1 ] || { usage; return; }
  path="$1"
  if scope show | "$PYTHON_BIN" -c 'import json,sys; exit(0 if json.load(sys.stdin).get("version") == 2 else 1)' 2>/dev/null; then
    fail 'exact-scope imports require dot intent Track plan/approval'; return
  fi
  relative="$(metadata validate "$path")"
  scope allowed "$relative"
  case "$relative" in *$'\n'*|*$'\t'*|*'{{'*|*'*'*|*'?'*|*'['*) fail 'unsupported target path'; return ;; esac
  if [ "$category" = templated ]; then cm add --force --template "$path"; else cm add --force "$path"; fi
  metadata taxonomy "$DOT_SOURCE" "$relative" "$category" "$os_name"
}
dot_remove() {
  [ ! -f "$DOT_SOURCE/dot-contract.json" ] || { fail 'stop tracking requires an exact dot intent untrack plan/approval; live files are retained'; return; }
  [ $# -eq 1 ] || { usage; return; }
  local relative
  if scope show | "$PYTHON_BIN" -c 'import json,sys; exit(0 if json.load(sys.stdin).get("version") == 2 else 1)' 2>/dev/null; then
    fail 'exact-scope changes require a reviewed dot intent plan'; return
  fi
  relative="$(metadata relative "$1")"
  scope allowed "$relative"
  cm forget --force "$1"
  metadata taxonomy "$DOT_SOURCE" "$relative"
}
dot_run() {
  [ $# -ge 1 ] || { usage; return; }
  local name="$1" script
  shift
  if [ "$name" = sync-skills ] && [ "$(scope skills)" != yes ]; then
    fail 'skills router is outside adoption scope'; return
  fi
  case "$name" in ''|*[!a-zA-Z0-9_-]*) fail 'invalid script name'; return ;; esac
  script="$DOT_SOURCE/scripts/$name.sh"
  [ -f "$script" ] && [ ! -L "$script" ] || { fail "unknown script: $name"; return; }
  bash "$script" "$@"
}
dot_update() {
  [ $# -eq 2 ] || { usage; return; }
  metadata update "$DOT_SOURCE/packages/pins.toml" "$1" "$2"
  dot_run install-pins --apply
}
dot_doctor() {
  [ $# -eq 0 ] || { usage; return; }
  local failures=0
  cm doctor || failures=1
  dot_run install-pins --check || failures=1
  metadata secrets "$DOT_SOURCE" "${DOT_SECRETS_FILE:-$HOME/.config/secrets.env}" || failures=1
  return "$failures"
}
case "${1:-}" in
  self-update) shift; dot_self_update "$@" ;;
  status|diff|push|pull|add|remove|run|update|doctor|scope|intent|layout) verb="$1"; shift; "dot_$verb" "$@" ;;
  *) usage ;;
esac
