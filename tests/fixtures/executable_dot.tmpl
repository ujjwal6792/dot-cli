#!/usr/bin/env bash
{{ $engine := env "DOT_ENGINE" -}}
{{ if hasKey . "dotEngine" -}}
{{ $engine = .dotEngine -}}
{{ if not $engine -}}{{ fail "explicit public dotEngine is required; run compatible dot init before applying" }}{{ end -}}
{{ end -}}
{{ if and (not $engine) (lstat (joinPath .chezmoi.homeDir ".local/state/dot/install.json")) -}}
{{ if eq (output "python3" "-B" "-c" "import json,sys; print(json.load(open(sys.argv[1])).get('version') == 2)" (joinPath .chezmoi.homeDir ".local/state/dot/install.json") | trim) "True" -}}
{{ fail "split installation requires explicit public dotEngine; run compatible dot init before applying" }}
{{ end -}}
{{ end -}}
{{ if $engine -}}
# Installed tooling and private configuration have independent ownership.
export DOT_ENGINE={{ $engine | shellQuote }}
export DOT_SOURCE={{ joinPath .chezmoi.sourceDir ".." | shellQuote }}
export DOT_CONFIG={{ .chezmoi.configFile | shellQuote }}
python3 -B "$DOT_ENGINE/contract.py" check --engine "$DOT_ENGINE" --source "$DOT_SOURCE" >/dev/null || exit 1
exec bash "$DOT_ENGINE/dot" "$@"
{{ else -}}
# Transitional development checkout; installed setup always records dotEngine.
exec bash {{ printf "%q" (joinPath .chezmoi.sourceDir ".." "tools/dot/dot") }} "$@"
{{ end -}}
